generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum ProjectKind {
  PROJECT
  PORTFOLIO
}

enum ExperienceLevel {
  INTERN
  ENTRY
  JUNIOR
  MID
  SENIOR
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkArrangement {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  REMOVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum ReportOutcome {
  NO_ACTION
  WARNING
  REMOVAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CANDIDATE)
  createdAt    DateTime @default(now())

  candidateProfile           CandidateProfile?
  organization               Organization?
  applicationStatusHistories ApplicationStatusHistory[]
  reportsFiled               Report[]                   @relation("ReportedByUser")
  reportsReviewed            Report[]                   @relation("ReviewedByUser")
}

model CandidateProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String  @default("")
  bio      String  @default("")
  location String  @default("")
  phone    String?
  links    Json    @default("[]")

  skills       CandidateSkill[]
  projects     Project[]
  applications Application[]
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  aliases         SkillAlias[]
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]
}

model SkillAlias {
  id      String @id @default(cuid())
  alias   String @unique
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model CandidateSkill {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidence           SkillEvidence[]

  @@unique([candidateProfileId, skillId])
}

model Project {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String
  url                String?
  kind               ProjectKind      @default(PROJECT)
  evidence           SkillEvidence[]
}

model SkillEvidence {
  id               String         @id @default(cuid())
  candidateSkillId String
  candidateSkill   CandidateSkill @relation(fields: [candidateSkillId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([candidateSkillId, projectId])
}

model Organization {
  id          String  @id @default(cuid())
  ownerUserId String  @unique
  ownerUser   User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  description String
  website     String?
  location    String
  jobs        Job[]
}

model Job {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  description     String
  experienceLevel ExperienceLevel
  jobType         JobType
  workArrangement WorkArrangement
  location        String
  deadline        DateTime?
  status          JobStatus       @default(DRAFT)
  createdAt       DateTime        @default(now())

  skills       JobSkill[]
  applications Application[]
  reports      Report[]

  @@index([status])
  @@index([experienceLevel])
  @@index([jobType])
  @@index([workArrangement])
  @@index([location])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model Application {
  id                 String            @id @default(cuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  coverNote          String?
  status             ApplicationStatus @default(SUBMITTED)
  createdAt          DateTime          @default(now())

  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, candidateProfileId])
}

model ApplicationStatusHistory {
  id              String            @id @default(cuid())
  applicationId   String
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status          ApplicationStatus
  changedByUserId String
  changedByUser   User              @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)
  changedAt       DateTime          @default(now())
}

model Report {
  id               String         @id @default(cuid())
  jobId            String
  job              Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterUserId   String
  reporterUser     User           @relation("ReportedByUser", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason           String
  details          String?
  status           ReportStatus   @default(OPEN)
  outcome          ReportOutcome?
  adminNote        String?
  reviewedByUserId String?
  reviewedByUser   User?          @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
}
